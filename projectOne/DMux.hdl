/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Nand(a=sel, b=sel, out=NegSel);
    Nand(a=in, b=NegSel, out=outA);
    Nand(a=outA, b=outA, out=a);
    Nand(a=in, b=sel, out=outB);
    Nand(a=outB, b=outB, out=b);
}